# ============================================================
# Vũ Học AI Radar v1.0 — Biến môi trường CỤC BỘ (template)
# ============================================================
# Đây chỉ là MẪU THAM CHIẾU. Đừng sửa file này để đặt secret thật.
# Cách dùng đúng:
#   1. Sao chép thành một file `.env` thật (ví dụ: `Copy-Item .env.example .env`)
#   2. Điền giá trị thật VÀO `.env` (file đó đã bị gitignore)
#   3. Secret chỉ sống trong environment — KHÔNG commit, không in ra log.
#
# Script `scripts/dev.ps1` KHÔNG tự đọc/nạp file này để chạy app;
# nó chỉ dùng làm danh sách tên biến cần có. Ứng dụng đọc secret trực
# tiếp từ environment (biến đã set trong shell/terminal của bạn).

# --- Xác thực admin (BẮT BUỘC khi dùng route /api/admin/*) ----------------
# Để trống ở file này: giá trị thật phải do bạn set trong environment,
# ví dụ PowerShell:
#   $env:ADMIN_TOKEN = 'chuoi-ngau-nhien-dai-thuc-te'
# Không dùng lại giá trị mẫu này trong sản phẩm.
ADMIN_TOKEN=

# --- Gateway AI Editorial (TÙY CHỌN) ---------------------------------------
# Nếu chưa set, ứng dụng vẫn chạy bằng phân loại quy tắc thuần (không gọi mạng).
# Cấu hình tối thiểu cần đủ cả ba biến (định dạng OpenAI-compatible).
#   AI_BASE_URL=https://gateway.example.com/v1
#   AI_API_KEY=  (giá trị thật của bạn, không để ở file này)
#   AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=